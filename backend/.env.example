# PostgreSQL
POSTGRES_DB=uits_db
POSTGRES_USER=uits_stankin_db
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=5433

SCHEDULE_SERVICE_HOST_PORT=8000

# openssl rand -base64 32
JWT_SECRET_KEY=
JWT_EXPIRATION=900000

REFRESH_EXPIRATION=1209600000
REFRESH_GRACE_PERIOD=60000
REFRESH_COOKIE_SECURE=true

LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_PERIOD=60000

ORPHAN_CLEANUP_MIN_AGE=86400000

# Разделы хранилища, которые подметает фоновая уборка. Раздел без владельца
# в списке быть не должен: его файлы удалять не у кого спросить.
ORPHAN_CLEANUP_CATEGORIES=news,avatars,achievements

# Origin'ы фронтенда через запятую. Локально можно не задавать — подставится
# http://localhost:5173. Для docker-compose.prod.yml переменная обязательна.
CORS_ALLOWED_ORIGINS=http://localhost:5173